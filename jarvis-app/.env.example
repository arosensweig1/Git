# ============================================================================
# JARVIS — ECM Prospecting Terminal · environment template
# Copy to .env and fill in.  .env is gitignored and MUST NEVER be committed.
# These are API credentials, NOT the Cap IQ / DealCloud web-portal logins
# (those are separate SSO/MFA systems and cannot be used by the app).
# ============================================================================

# ---- App-level website login -------------------------------------------------
# Each user is "username:bcrypt_hash".  Separate multiple users with a comma.
# Generate a hash with:  python make_hash.py 'your-password'
# (The original test user was aragpjarvistest1 — rotate it before any real use.)
APP_USERS=
APP_AUTH_COOKIE_KEY=change-me-to-a-long-random-string

# ---- Capital IQ (SOLE market-data source) -----------------------------------
# Confirm the exact base URL for your entitlement against the S&P API docs.
CAPIQ_BASE_URL=https://api-ciq.marketintelligence.spglobal.com/gdsapi/rest/v3/clientservice.json
CAPIQ_USERNAME=
CAPIQ_PASSWORD=
# Optional: some entitlements use an API key instead of user/pass
CAPIQ_API_KEY=
# Saved-screen / list identifier you build in Cap IQ Pro (Set B universe)
CAPIQ_UNIVERSE_SCREEN_ID=

# ---- DealCloud (CRM coverage; Excel upload is the fallback) ------------------
DC_SITE_URL=
DC_CLIENT_ID=
DC_CLIENT_SECRET=

# ---- Optional supplements ----------------------------------------------------
HUNTER_API_KEY=
ANTHROPIC_API_KEY=

# ---- Tunable business rules --------------------------------------------------
MONTHS_THRESHOLD=24
MARKET_CAP_CAP=500000000
